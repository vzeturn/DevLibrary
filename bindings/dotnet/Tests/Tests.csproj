<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test runner: dotnet run -c Release. Exit code 0 = all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevLibrary\DevLibrary.csproj" />
    <!-- A project reference does not resolve runtimes/<rid>/native; copy the host's library. -->
    <None Include="..\runtimes\win-x64\native\dl_ffi.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" CopyToOutputDirectory="PreserveNewest" Link="dl_ffi.dll" />
    <None Include="..\runtimes\linux-x64\native\libdl_ffi.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))" CopyToOutputDirectory="PreserveNewest" Link="libdl_ffi.so" />
    <None Include="..\runtimes\osx-arm64\native\libdl_ffi.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" CopyToOutputDirectory="PreserveNewest" Link="libdl_ffi.dylib" />
  </ItemGroup>

</Project>
