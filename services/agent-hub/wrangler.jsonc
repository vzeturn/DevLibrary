{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-hub",
  "account_id": "9e6167261f0c8f36dc41de20f0821c88",
  // Owner chose the hub host on 2026-11-18 (RT-0164).
  "routes": [{ "pattern": "agent.pms.id.vn", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // workers.dev is the fallback hub host (PROTOCOL.md §2.1): agents only, admin stays on the custom domain.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "agent-hub-db", "database_id": "81c8a571-9363-414b-bdcc-59944f0e961c", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "agent-hub-artifacts" }],
  // Prunes the nonce replay table.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "HEARTBEAT_SECONDS": "60",
    // Update lanes (docs/decisions/0001-update-lanes.md): canary beats fast, stable soaks by bump.
    "CANARY_HEARTBEAT_SECONDS": "15",
    "GATE_MIN_AGENTS": "1",
    "GATE_SOAK_HOURS_PATCH": "2",
    "GATE_SOAK_HOURS_MINOR": "24",
    "GATE_SOAK_HOURS_MAJOR": "72",
    "MINOR_RAMP": "0:10,24:50,48:100",
    // Hub hosts handed to agents, primary first; the fallback serves /v1, /install and /healthz only.
    "HUB_URLS": "https://agent.pms.id.vn,https://agent-hub.vutq-sense.workers.dev"
  },
  // /mcp behind Access (ADR 0008, RT-0781): set MCP_ACCESS_AUD and "MCP_ACCESS_REQUIRED": "true" in vars once its Access app exists; ACCESS_TEAM_DOMAIN is shared with /admin.
  // Secrets (never in git): `wrangler secret put ADMIN_TOKEN`; `BENCH_KEY` (base64 of 32 random bytes) enables /admin/bench; `MCP_TOKEN` opens the read-only ops console /mcp.
  "observability": { "enabled": true }
}
