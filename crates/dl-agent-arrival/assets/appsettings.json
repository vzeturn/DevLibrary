{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "CloudBaseUrl": "https://sync.example.com",
    "PmsConnectionString": "REPLACE_VIA_ENV: Agent__PmsConnectionString",
    "IdentityFile": "agent-identity.bin",
    "IdempotencyFile": "agent-idempotency.jsonl",
    "MaxConcurrency": 4,
    "SnapshotCapacity": 2000,
    "CommandTimeoutSeconds": 15,
    "LockTimeoutSeconds": 8,
    "AutoUpdate": true,
    "UpdateCheckIntervalMinutes": 60,
    "Watches": [
      {
        "Operation": "dashboard.fo-command-center",
        "Parameters": { "HotelDate": "{today}" },
        "IntervalSeconds": 20
      }
    ]
  }
}
