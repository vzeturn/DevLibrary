<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A minimal ASP.NET Core SignalR hub for the ignored tests in tests/aspnet.rs.
       SignalR ships with the shared framework: no NuGet packages are needed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DlSignalrTestHub</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
